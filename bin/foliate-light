#!/bin/bash
# Launch Foliate with small patches to its built-in resources:
#
# 1. reader/reader.html: with the desktop in dark mode, Foliate blends
#    annotation highlights with mix-blend-mode "screen" (meant for dark pages),
#    which washes them out on the always-light custom themes. Switch to
#    "multiply".
# 2. book-viewer.js: add Ctrl+H to highlight the current selection (the
#    selection popover has keyboard focus while open; stock Foliate only offers
#    a Highlight button). The shortcut must also pop the popover down, as the
#    button does; otherwise its pointer grab stays active and the window stops
#    taking clicks. Stock Foliate then opens the annotation popover (color /
#    note / delete) for the new highlight; Ctrl+H sets a one-shot flag that
#    skips it, so the shortcut is a quick highlight. The button still opens it.
#    Ctrl+1 / Ctrl+2 do the same in yellow / light blue (GTK color dialog's
#    first blue, rgb(153,193,241)) without changing the
#    last-used color that Ctrl+H and the button use.
#    Clicking an existing highlight opens its annotation popover; there,
#    Ctrl+1 / Ctrl+2 recolor that highlight and close the popover (same as
#    picking the color from its drop-down, minus changing the last-used color).
#
# Each file is extracted fresh from the packaged gresource on every launch (so
# patches track Foliate updates) and loaded via G_RESOURCE_OVERLAYS. If any
# patch for a file no longer applies cleanly, that whole file is skipped and
# Foliate runs stock for it.
#
# Upstream context: https://github.com/johnfactotum/foliate/issues/1597

GRES=/usr/share/com.github.johnfactotum.Foliate/com.github.johnfactotum.Foliate.gresource
PREFIX=/com/github/johnfactotum/Foliate
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/foliate-light
OVERLAYS=()
COLOR1=yellow
COLOR2='rgb(153,193,241)'  # first blue in the GTK color dialog

# patch <resource path under PREFIX> <literal anchor> <sed expression> [<anchor> <expr>]...
# Applies only if every anchor appears exactly once in the packaged file.
patch() {
  local res=$1 out=$CACHE/${1//\//_} src
  shift
  src=$(gresource extract "$GRES" "$PREFIX/$res" 2>/dev/null) || return
  while (($# >= 2)); do
    [[ $(grep -cF -- "$1" <<<"$src") == 1 ]] || {
      echo "foliate-light: skipping $res (patch anchor not found: $1)" >&2; return; }
    src=$(sed -- "$2" <<<"$src") || return
    shift 2
  done
  [[ -n $src ]] || return
  printf '%s\n' "$src" >"$out.tmp" && mv "$out.tmp" "$out" &&
    OVERLAYS+=("$PREFIX/$res=$out")
  rm -f "$out.tmp"
}

if [[ -f $GRES ]] && mkdir -p "$CACHE"; then
  patch reader/reader.html \
    '--overlayer-highlight-blend-mode: screen;' \
    's/--overlayer-highlight-blend-mode: screen;/--overlayer-highlight-blend-mode: multiply;/'

  patch book-viewer.js \
    'const popover = new SelectionPopover()' \
    "s/const popover = new SelectionPopover()/&\n            const foliateLightHighlight = color => () => { const prev = this.highlight_color; if (color) this.highlight_color = color; this._foliateLightQuick = true; popover.activate_action('selection.highlight', null); if (color) this.highlight_color = prev; popover.popdown(); return true }\n            popover.add_controller(utils.addShortcuts({ '<ctrl>h': foliateLightHighlight(null), '<ctrl>1': foliateLightHighlight('$COLOR1'), '<ctrl>2': foliateLightHighlight('$COLOR2') }))/" \
    "if (type === 'annotation') return new Promise(resolve => {" \
    "s/if (type === 'annotation') return new Promise(resolve => {/&\n            if (this._foliateLightQuick) { this._foliateLightQuick = false; resolve(); return }/" \
    "popover.connect('closed', () => resolve())" \
    "s/popover.connect('closed', () => resolve())/const foliateLightRecolor = color => () => { popover.annotation.set_property('color', color); popover.popdown(); return true }\n            popover.add_controller(utils.addShortcuts({ '<ctrl>1': foliateLightRecolor('$COLOR1'), '<ctrl>2': foliateLightRecolor('$COLOR2') }))\n            &/"

  if ((${#OVERLAYS[@]})); then
    joined=$(IFS=:; echo "${OVERLAYS[*]}")
    export G_RESOURCE_OVERLAYS="$joined${G_RESOURCE_OVERLAYS:+:$G_RESOURCE_OVERLAYS}"
  fi
fi

exec /usr/bin/foliate "$@"
