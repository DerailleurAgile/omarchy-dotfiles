#!/usr/bin/env bash
# Open one real terminal window per font, side by side, so you can see how
# each one actually renders — not a name in a browser tab, the real glyph
# rendering, box-drawing, ligatures, and Nerd Font icons your prompt uses.
#
# Why this exists: a terminal reads its font once at startup and never
# hot-reloads it, so there's no way to preview fonts inside one running
# terminal. This instead spawns a separate `foot` window per font (each
# overridden with -f, no config file touched); Hyprland tiles them onto
# your current workspace like any other new window.
#
# Windows are spawned directly (setsid ... & disown) rather than through
# `hyprctl dispatch exec` — this machine's Hyprland fork routes `dispatch`
# through a Lua config layer where plain exec strings don't reliably spawn.
set -euo pipefail

SIZE=14

# One representative per genuinely distinct base typeface. Most of what
# `fc-list` turns up per family is near-duplicates: the Meslo family alone
# ships as 12 entries on this machine (S/M/L line-height presets, each with
# a plain/Mono/DZ Nerd Font icon-width patch) that all render as the same
# letterforms. If two fonts still look identical side by side, check
# `font-compare --list` first — they may just be variants of one typeface.
DISTINCT_FONTS=(
  "CaskaydiaMono Nerd Font"
  "JetBrainsMono Nerd Font"
  "MesloLGS Nerd Font"
  "BitstromWera Nerd Font"
  "iA Writer Mono S"
  "Liberation Mono"
  "Adwaita Mono"
)

usage() {
  cat <<'EOF'
Usage: font-compare [--size N] <font-name> [<font-name> ...]
       font-compare [--size N] --distinct
       font-compare --list

Opens one foot window per font, tiled onto your current workspace like any
other new window, so you can compare real rendered output side by side.
Re-running closes the previous batch first. Close windows individually with
your normal close-window bind when you're done comparing.

  --size N     terminal font size for the comparison windows (default: 14)
  --distinct   compare one representative of each genuinely different
               typeface installed, skipping near-duplicate variants
  --list       show every monospace font name you can pass in

Examples:
  font-compare "CaskaydiaMono Nerd Font" "JetBrainsMono Nerd Font" "Adwaita Mono"
  font-compare --size 20 --distinct
EOF
}

list_fonts() {
  fc-list :spacing=100 -f "%{family[0]}\n" | grep -v -iE 'emoji|signwriting|omarchy' | sort -u
}

if [[ "${1:-}" == "--size" ]]; then
  SIZE="$2"
  shift 2
fi

if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 0
fi

if [[ "$1" == "--list" ]]; then
  list_fonts
  exit 0
fi

if [[ "$1" == "--distinct" ]]; then
  set -- "${DISTINCT_FONTS[@]}"
fi

if ! command -v hyprctl >/dev/null || ! command -v foot >/dev/null; then
  echo "font-compare needs hyprctl and foot on PATH." >&2
  exit 1
fi

DATA_DIR="$HOME/.local/share/font-preview"
SAMPLE="$DATA_DIR/terminal-sample.sh"
mkdir -p "$DATA_DIR"

# Shared sample-content script every window runs, then drops to a live shell
# so you can also try your actual prompt/commands in each font.
cat >"$SAMPLE" <<'SCRIPT'
#!/usr/bin/env bash
font="$1"
rule=$(printf '=%.0s' $(seq 1 "${#font}"))
echo "$rule"
echo "$font"
echo "$rule"
echo
echo "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
echo "abcdefghijklmnopqrstuvwxyz"
echo "0123456789"
echo "The quick brown fox jumps over the lazy dog."
echo
echo "Confusables:   Il1  O0  5S  B8  rn m  vv w"
echo "Ligatures:     ->  =>  !=  ==  <=  >=  ===  |>  <|"
echo "Box drawing:   ┌─┬─┐ │ │ │ └─┴─┴┘  ═══  ╔╗╚╝"
echo "Powerline:                  "
echo "Nerd icons:                     "
echo "Punctuation:   {}[]()<> \"quotes\" 'ticks' \`code\` | \\ / ~ @ # \$ % ^ & *"
echo
echo "(live shell below — try your real prompt; close this window when done)"
SCRIPT
chmod +x "$SAMPLE"

# Close any windows left over from a previous run (tagged with a fixed
# app-id so this only ever matches windows this script spawned).
pkill -f -- '-a fontcompare-tag' 2>/dev/null || true

i=0
for font in "$@"; do
  i=$((i + 1))
  runner="$DATA_DIR/run-$i.sh"
  inner="\"$SAMPLE\" \"$font\"; exec bash"
  printf '#!/bin/bash\nexec foot -f %q -a fontcompare-tag -T %q bash -c %q\n' \
    "${font}:size=${SIZE}" "$font" "$inner" >"$runner"
  chmod +x "$runner"
  setsid "$runner" >/dev/null 2>&1 </dev/null &
  disown
done

echo "Opened $# window(s), tiled onto your current workspace."
echo "Close each one with your normal close-window bind when you're done comparing."
